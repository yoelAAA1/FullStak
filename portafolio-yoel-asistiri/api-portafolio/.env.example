# ==============================================================
#  .env.example  →  cópialo como ".env" y cambia los valores
#  (el .env NUNCA se sube a GitHub: tiene contraseñas)
# ==============================================================

# Cadena de conexión a PostgreSQL:
# postgresql://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/NOMBRE_BASE
#   USUARIO     → normalmente "postgres"
#   CONTRASEÑA  → la que pusiste al instalar PostgreSQL
#   SERVIDOR    → localhost (tu propia PC)
#   PUERTO      → 5432 es el puerto por defecto de PostgreSQL
#   NOMBRE_BASE → la base que creamos: portafolio_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portafolio_db"

# Puerto donde escucha la API → http://localhost:3000
PORT=3000

# development = muestra el detalle de los errores; production = los oculta
NODE_ENV=development

# Páginas (orígenes) que pueden llamar a la API desde el navegador, separadas por coma:
#   http://localhost:5173  → la app React con Vite
#   http://127.0.0.1:5500  → el portafolio HTML con Live Server (sesión 3)
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5500"

# Clave del administrador. Se envía en el header "x-api-key" para crear, editar y borrar.
# Es también la clave que escribes en /admin/login de la app React.
ADMIN_API_KEY="yoel-clave-secreta-2026"

# Ruta donde se publica la documentación Swagger
DOCUMENTATION="/api-docs"
